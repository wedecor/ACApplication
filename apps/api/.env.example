NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ac_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ac_platform?schema=public"
DATABASE_POOL_MAX=10

REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-me-use-openssl-rand-base64-32-min-chars"
JWT_REFRESH_SECRET="change-me-use-openssl-rand-base64-32-min-chars"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=ac-platform
JWT_AUDIENCE=ac-platform-clients

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# Codes issued per destination per window, and the window for that cap and the failed-attempt lock.
OTP_ISSUE_LIMIT=5
OTP_LOCK_WINDOW_SECONDS=900

API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# RBAC — registry sync and startup validation
RBAC_VALIDATE_ON_STARTUP=true
# Set true on the deploy that changes role permissions (production refuses to boot while roles drift).
RBAC_SYNC_ON_STARTUP=false

SMS_PROVIDER=console
RATE_LIMIT_GLOBAL_RPS=100
RATE_LIMIT_AUTH_RPS=5
# Proxies trusted for the client IP: false (socket address), a hop count (e.g. 1), or proxy IPs/CIDRs. Never true.
TRUST_PROXY=false
# Shared with the website's server-side proxy (x-internal-token). When set, lead intake only accepts proxied calls.
PUBLIC_LEAD_API_TOKEN=

# Payment reconciliation cron — re-checks stale PENDING payment txns with the gateway
PAYMENTS_RECONCILE_ENABLED=true
PAYMENTS_RECONCILE_STALE_MINUTES=15
PAYMENTS_RECONCILE_BATCH_SIZE=100

# ---------- Object storage (S3-compatible; MinIO from docker-compose in dev) ----------
# Create the bucket once in the MinIO console (http://localhost:9001) and set
# an anonymous "download" policy on it if S3_PUBLIC_URL points straight at MinIO.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="ac-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/ac-media"
S3_FORCE_PATH_STYLE="true"
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=900

# Extra browser origins allowed by the API (comma-separated), e.g. Expo web previews.
CORS_EXTRA_ORIGINS=
