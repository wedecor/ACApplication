{
  "expo": {
    "name": "AC Technician",
    "slug": "ac-technician",
    "scheme": "actechnician",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f59db"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acplatform.technician",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show your current job route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Background location keeps customers updated on your ETA."
      }
    },
    "android": {
      "package": "com.acplatform.technician",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AC Technician needs your location to update job ETAs."
        }
      ],
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true }
  }
}
