{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env.*local",
    "**/.env",
    "tsconfig.json",
    ".prettierrc",
    ".prettierignore"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        ".expo/**",
        "out/**"
      ],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "NEXT_PUBLIC_*",
        "API_URL",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "REFERRAL_REWARD_MINOR",
        "REFERRAL_REWARD_POINTS",
        "LOYALTY_POINTS_PER_100",
        "REVIEW_REQUEST_DELAY_MINUTES",
        "REVIEW_REQUEST_CHANNEL",
        "GOOGLE_REVIEW_URL",
        "GROWTH_SCHEDULER_DISABLED"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^db:generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/**/*.{ts,tsx,js,jsx}",
        "**/*.test.{ts,tsx,js,jsx}",
        "**/*.spec.{ts,tsx,js,jsx}"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": [
        "node_modules/.prisma/**",
        "src/generated/**"
      ]
    },
    "db:migrate": {
      "cache": false,
      "persistent": false
    }
  },
  "globalPassThroughEnv": [
    "ADMIN_URL",
    "BRAND_ADDRESS",
    "BRAND_EMAIL",
    "BRAND_GSTIN",
    "BRAND_LEGAL_NAME",
    "BRAND_NAME",
    "BRAND_PAN",
    "BRAND_PHONE",
    "BRAND_WEBSITE",
    "CALL_CENTER_FROM_NUMBER",
    "CALL_CENTER_PROVIDER",
    "CORS_EXTRA_ORIGINS",
    "FINANCE_SCHEDULER_DISABLED",
    "GOOGLE_MAPS_API_KEY",
    "GST_HOME_STATE",
    "INVENTORY_SCHEDULER_DISABLED",
    "LOG_LEVEL",
    "MAPBOX_TOKEN",
    "OTP_ISSUE_LIMIT",
    "OTP_LOCK_WINDOW_SECONDS",
    "PAYMENTS_PROVIDER",
    "PORT",
    "PUBLIC_LEAD_API_TOKEN",
    "RATE_LIMIT_GLOBAL_RPS",
    "RATE_LIMIT_PUBLIC_LEAD_RPM",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    "RBAC_SYNC_ON_STARTUP",
    "REDIS_PASSWORD",
    "REDIS_TLS",
    "SENTRY_TRACES_SAMPLE_RATE",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SWAGGER_ENABLED",
    "TASK_REMINDERS_DISABLED",
    "TRUSTED_PROXY_HOPS",
    "TRUST_PROXY",
    "WEB_INTERNAL_API_URL",
    "WEB_TENANT_ID",
    "WEB_URL",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_APP_SECRET",
    "WHATSAPP_DEFAULT_TENANT_ID",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_VERIFY_TOKEN",
    "WORKFLOW_WORKER_CONCURRENCY"
  ]
}
