{
  "name": "@ac/database",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Prisma schema, client and migrations for AC Platform.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "require": "./dist/seed/index.js",
      "default": "./dist/seed/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts",
      "require": "./dist/rbac/index.js",
      "default": "./dist/rbac/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "prisma", "package.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "format": "prisma format",
    "validate": "prisma validate",
    "seed": "tsx src/seed/index.ts",
    "reset": "prisma migrate reset --force && pnpm seed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@ac/auth": "workspace:*",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@ac/eslint-config": "workspace:*",
    "@ac/typescript-config": "workspace:*",
    "@types/node": "^26.1.0",
    "eslint": "^9.12.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
