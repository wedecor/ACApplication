{
  "name": "@ac/analytics",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Provider-agnostic analytics & product telemetry interface.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "package.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ac/types": "workspace:*"
  },
  "devDependencies": {
    "@ac/eslint-config": "workspace:*",
    "@ac/typescript-config": "workspace:*",
    "eslint": "^10.4.0",
    "typescript": "^5.6.3"
  }
}
