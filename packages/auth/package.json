{
  "name": "@ac/auth",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Auth primitives: JWT, refresh tokens, OTP, session, RBAC, permission matrix.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts",
      "require": "./dist/rbac/index.js",
      "default": "./dist/rbac/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "require": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./otp": {
      "types": "./dist/otp/index.d.ts",
      "require": "./dist/otp/index.js",
      "default": "./dist/otp/index.js"
    },
    "./password": {
      "types": "./dist/password/index.d.ts",
      "require": "./dist/password/index.js",
      "default": "./dist/password/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "package.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ac/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "ms": "^2.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ac/eslint-config": "workspace:*",
    "@ac/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.16.11",
    "eslint": "^10.6.0",
    "typescript": "^5.6.3"
  }
}
