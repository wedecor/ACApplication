# ============================================================================
# AC Platform - Root Environment Example
# Copy this file to .env at the root for local development of shared tools.
# App-specific envs live in apps/<app>/.env.example
# ============================================================================

# ---------- Runtime ----------
NODE_ENV=development

# ---------- Database (PostgreSQL) ----------
# Pooled (PgBouncer) connection for the application
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ac_platform?schema=public&pgbouncer=true&connection_limit=10"
# Direct connection (used by Prisma Migrate, introspect)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ac_platform?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_TLS="false"

# ---------- Auth ----------
JWT_SECRET="replace-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="replace-with-openssl-rand-base64-32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- App URLs ----------
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ---------- Object storage (S3-compatible; MinIO from docker-compose in dev) ----------
# Create the bucket once in the MinIO console (http://localhost:9001) and set
# an anonymous "download" policy on it if S3_PUBLIC_URL points straight at MinIO.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="ac-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/ac-media"
S3_FORCE_PATH_STYLE="true"
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=900

# ---------- Observability ----------
SENTRY_DSN=""
LOG_LEVEL="debug"

# ---------- Integrations (set in respective package envs) ----------
# WhatsApp / Razorpay / Twilio / SendGrid envs live in their package examples.
